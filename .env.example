# SQLite database file
DATABASE_URL=sqlite:///./cybersecurity_secure_api.db

# Session lifetime
SESSION_EXPIRE_MINUTES=30

# Lock an account after this many consecutive failed attempts
LOCKOUT_THRESHOLD=5
LOCKOUT_MINUTES=15

# Maximum complete HTTP request body
MAX_BODY_BYTES=16384

# Argon2id parameters (adjust only after benchmarking your deployment)
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=2

# Set true only for local development
ENABLE_DOCS=true
